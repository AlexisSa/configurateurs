  "optionGroups": {
    "dti_rj45": {
      "label": "DTI RJ45",
      "type": "single",
      "optional": true,
      "description": "Point d'arrivée et de brassage de la ligne opérateur (téléphone / internet)."
    },
    "dti_fibre": {
      "label": "DTI fibre",
      "type": "single",
      "optional": true,
      "description": "Point d'arrivée et de raccordement de la fibre optique (DTIO)."
    },
    "rj45": {
      "label": "Embases RJ45",
      "type": "quantity",
      "optional": true,
      "min": 0,
      "presets": [
        2,
        4,
        6,
        8,
        10,
        20
      ],
      "description": "Embases à clipser pour câbler les prises réseau du logement."
    },
    "cordon_rj45": {
      "label": "Cordons RJ45",
      "type": "quantity",
      "optional": true,
      "min": 0,
      "max": 48,
      "description": "Cordons de brassage RJ45/RJ45 pour relier le DTI, la box ou les équipements du coffret."
    },
    "tv": {
      "label": "Répartiteur TV",
      "type": "single",
      "optional": true,
      "description": "Distribue le signal TV (antenne / satellite) vers plusieurs prises."
    },
    "cordon_balun": {
      "label": "Cordon balun TV",
      "type": "single",
      "optional": true,
      "description": "Cordon balun RJ45 / prise F pour transmettre le signal TV sur câble Ethernet."
    },
    "prise": {
      "label": "Prise 2P+T",
      "type": "quantity",
      "optional": true,
      "min": 0,
      "max": 2,
      "description": "Prise de courant pour alimenter la box ou les équipements du coffret."
    },
    "brassage": {
      "label": "Brassage",
      "type": "single",
      "optional": false,
      "description": "Emplacement du brassage réseau : à l'intérieur du coffret (standard) ou à l'extérieur pour un accès facilité aux câbles."
    },
    "etagere_box": {
      "label": "Étagère / support box",
      "type": "single",
      "optional": true,
      "description": "Support pour poser la box opérateur à l'intérieur du coffret."
    },
    "capot": {
      "label": "Capot de protection",
      "type": "single",
      "optional": true,
      "description": "Capot de protection des connexions du coffret."
    },
    "rehausse": {
      "label": "Rehausse saillie",
      "type": "single",
      "optional": true,
      "description": "Rehausse métallique pour fixation en saillie (+50 mm de profondeur)."
    },
    "porte": {
      "label": "Porte",
      "type": "single",
      "optional": true,
      "description": "Porte de fermeture du coffret."
    }
  },
